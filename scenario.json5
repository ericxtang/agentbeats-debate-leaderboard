{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "google_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "google_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "topic": "Should artificial intelligence be regulated?",
          "num_rounds": 1
        },
        "participant_roles": {
          "green": "debate_judge",
          "purple1": "pro_debater",
          "purple2": "con_debater"
        }
      }
    },
    "debate_judge": {
      "manifest": "./green-agent.json5",
      "config": {
        "google_api_key": "${config.google_api_key}"
      }
    },
    "pro_debater": {
      "manifest": "./debater.json5",
      "config": {
        "google_api_key": "${config.google_api_key}"
      }
    },
    "con_debater": {
      "manifest": "./debater.json5",
      "config": {
        "google_api_key": "${config.google_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#debate_judge.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#pro_debater.a2a"
    },
    {
      "to": "#gateway.purple2",
      "from": "#con_debater.a2a"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "debate_judge": "",
      "pro_debater": "",
      "con_debater": ""
    }
  }
}
